# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection String
# Format: postgres://username:password@hostname:port/database_name
#
# Examples:
# Local PostgreSQL:
DATABASE_URL=postgres://postgres:password@localhost:5432/lifemanager
#
# Supabase (Cloud):
# DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Neon (Serverless Postgres):
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/lifemanager?sslmode=require
#
# AWS RDS / DigitalOcean / Railway / Render:
# DATABASE_URL=postgres://[user]:[password]@[host]:5432/[dbname]?sslmode=require

# AI & Model Configuration
CHATBOT_MODEL=gpt-4o
VAULT_ENCRYPTION_ROUNDS=100000
